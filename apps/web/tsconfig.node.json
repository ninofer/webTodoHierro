{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    /* Un proyecto referenciado por `tsc -b` no puede tener noEmit (TS6310).
       Emite sólo declaraciones, a una carpeta temporal que ya está ignorada. */
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
