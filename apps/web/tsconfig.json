{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    /* Igual que el alias de Vite: tsc también verifica contra el fuente de
       shared, para que el chequeo de tipos y el empaquetado miren lo mismo. */
    "paths": {
      "@todohierro/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
