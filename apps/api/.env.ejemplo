# Variables que lee el API. La guarda `env-documentado` comprueba que no quede
# ninguna leída en el código sin documentar acá.
#
# Este archivo se commitea. El .env real NO.

# --- Dónde escucha el proceso -------------------------------------------------
# 127.0.0.1 en produccion: IIS es el unico camino hacia el API. Si escucha en
# 0.0.0.0, cualquiera en la red le habla directo y saltea el HTTPS.
API_HOST=127.0.0.1
API_PUERTO=3001

# --- Base de datos del cliente ------------------------------------------------
# Alcanzada por la VPN terminada en el Mikrotik. Solo lectura.
SQL_HOST=
SQL_PUERTO=1433
SQL_BASE=todoHierro
SQL_USUARIO=web_ro
SQL_CLAVE=
# Cuanto espera un intento de conexion antes de darse por vencido. Si la base no
# responde, el API arranca igual y reintenta cada 30 s.
SQL_TIMEOUT_CONEXION_MS=10000

# --- Sesion -------------------------------------------------------------------
# Minimo 32 caracteres. Al rotarla, todas las sesiones abiertas caen.
JWT_SECRETO=
JWT_HORAS=12

# --- Cache del catalogo -------------------------------------------------------
CACHE_REFRESCO_MS=120000

# --- Padron de usuarios del portal --------------------------------------------
# Ruta al archivo con los usuarios y sus hashes argon2. Fuera del repositorio.
USUARIOS_ARCHIVO=C:\todohierro\usuarios.json
