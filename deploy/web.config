<?xml version="1.0" encoding="UTF-8"?>
<!--
  OBSOLETO desde el 22/09/2026: pc-servicios pasa de Windows/IIS a Ubuntu/
  nginx. El equivalente vivo es deploy/nginx-todohierro.conf; los pasos de
  instalación están en docs/02-despliegue.md. Este archivo queda como
  referencia histórica, no se usa en la instalación actual.

  Configuracion de IIS para el portal.

  Se copia a la raiz del sitio, junto a lo que produce `npm run build:web`
  (apps/web/dist). IIS sirve el frontend y hace de proxy inverso de /api al
  proceso de Node, que escucha solo en 127.0.0.1.

  Requiere Application Request Routing (ARR) instalado, con el proxy habilitado
  en la configuracion del servidor, y URL Rewrite.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!--
          /api va al proceso de Node. Va primero: si quedara despues de la regla
          del SPA, cualquier ruta del API terminaria devolviendo el index.html y
          el error seria "la pantalla carga pero no trae datos".
        -->
        <rule name="api-a-node" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/api/{R:1}" />
          <serverVariables>
            <!-- Para que el freno del login vea la IP real y no la de IIS. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!--
          Todo lo que no sea un archivo existente va al index.html, porque el
          ruteo lo resuelve React en el navegador. Sin esto, recargar estando en
          /login devuelve 404.
        -->
        <rule name="spa" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- IIS anuncia su version por defecto. No hace falta que lo haga. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- El index.html nunca se cachea: si queda pegado, el navegador sigue
           pidiendo los assets de la version anterior despues de publicar. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

  </system.webServer>
</configuration>
